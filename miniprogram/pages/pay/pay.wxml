<view class="page">
  <view wx:if="{{loading}}" class="empty">正在获取支付参数…</view>

  <block wx:else>
    <view class="hero">
      <view class="icon">{{status === 'SUCCESS' ? '✓' : (status === 'PAYING' || status === 'JUMPING' ? '…' : '!')}}</view>
      <view class="text">{{statusText}}</view>
      <view wx:if="{{payTime}}" class="muted">{{payTime}}</view>
    </view>

    <view class="card">
      <view class="title">{{body}}</view>
      <view class="row"><text class="muted">订单号</text><text>{{orderNo}}</text></view>
      <view class="row"><text class="muted">支付金额</text><text class="amount">¥{{amountText}}</text></view>
    </view>

    <view wx:if="{{errmsg}}" class="banner">{{errmsg}}</view>
    <view wx:if="{{fromH5}}" class="banner">您从浏览器跳转而来，支付完成后请返回浏览器查看结果。</view>

    <button
      wx:if="{{status === 'READY' || status === 'FAIL' || status === 'CANCEL'}}"
      class="btn"
      bindtap="onTapPay"
    >确认支付</button>

    <button
      wx:if="{{status === 'PAYING' || status === 'INIT' || status === 'CLOSED'}}"
      class="btn"
      bindtap="onTapRetry"
    >重试</button>

    <button wx:if="{{status === 'PAYING'}}" class="btn ghost" bindtap="onTapOrders">去订单列表查看结果</button>
    <button wx:if="{{status === 'SUCCESS'}}" class="btn" bindtap="onTapHome">已完成，返回首页</button>
  </block>
</view>
