<view class="page">
  <view wx:if="{{tip}}" class="banner">{{tip}}</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{order}}">
    <view class="card">
      <view class="hero">
        <view class="icon">{{order.status === 'SUCCESS' ? '✓' : (order.status === 'PAYING' ? '…' : '!')}}</view>
        <view class="text">
          {{order.status === 'SUCCESS' ? '已支付' : (order.status === 'PAYING' ? '待支付' : (order.status === 'CLOSED' ? '已关闭' : '支付失败'))}}
        </view>
      </view>
      <view class="row"><text class="muted">金额</text><text class="amount">¥{{order.amountText}}</text></view>
    </view>

    <view class="card">
      <view class="title">订单信息</view>
      <view class="row">
        <text class="muted">订单号</text>
        <text bindtap="onTapCopy">{{order.orderNo}}</text>
      </view>
      <view class="row"><text class="muted">商品</text><text class="wrap">{{order.body}}</text></view>
      <view class="row"><text class="muted">商户请求单号</text><text>{{order.reqsn}}</text></view>
      <view wx:if="{{order.payTime}}" class="row"><text class="muted">支付时间</text><text>{{order.payTime}}</text></view>
    </view>

    <button wx:if="{{order.status === 'PAYING'}}" class="btn" bindtap="onTapPay">去支付</button>
  </block>
</view>
